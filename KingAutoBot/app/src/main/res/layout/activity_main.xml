<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👑 King AI AutoBot"
            android:textColor="#00E676"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Standalone Mobile Automation (No Laptop / No ADB)"
            android:textColor="#B0BEC5"
            android:textSize="12sp"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="16dp" />

        <!-- Permissions Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Required Permissions"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"
                android:paddingBottom="8dp" />

            <Button
                android:id="@+id/btn_enable_accessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable Accessibility Service"
                android:backgroundTint="#1E88E5"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_enable_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable Floating Overlay"
                android:backgroundTint="#1E88E5" />
        </LinearLayout>

        <!-- AI Config Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Gemini Cloud AI Settings"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Google Gemini API Key:"
                android:textColor="#B0BEC5"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/et_api_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="#2C2C2C"
                android:padding="10dp"
                android:hint="Enter Gemini API key"
                android:textColorHint="#757575"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_cache_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cached Answers: Loading..."
                android:textColor="#00E676"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Mode Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Automation Mode"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"
                android:paddingBottom="8dp" />

            <RadioGroup
                android:id="@+id/rg_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rb_shake_master"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shake Master (Quiz + Video + Install Bypass)"
                    android:textColor="#FFFFFF"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rb_universal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Universal AI Agent (Any app without training)"
                    android:textColor="#FFFFFF" />
            </RadioGroup>
        </LinearLayout>

        <Button
            android:id="@+id/btn_launch_widget"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="LAUNCH FLOATING CONTROLLER"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="15sp"
            android:backgroundTint="#00E676" />

        <Button
            android:id="@+id/btn_stop_bot"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="32dp"
            android:text="STOP BOT &amp; CLOSE CONTROLLER"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:backgroundTint="#D50000" />

    </LinearLayout>
</ScrollView>
